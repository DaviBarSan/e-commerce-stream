# Pinned versions. Read by the Makefile, scripts/doctor.sh and (later) the Terraform stacks.
# Plain KEY=VALUE lines only: this file is sourced by bash and included by make.

# --- Tools (checked by `make doctor`) ---
# Terraform must match exactly (it is also the stacks' required_version).
TERRAFORM_VERSION=1.16.2
# Minimum versions: Docker Desktop and uv update themselves.
DOCKER_MIN_VERSION=29.0.0
MAKE_MIN_VERSION=4.4
UV_MIN_VERSION=0.9.8
PYTHON_MIN_VERSION=3.12

# --- Container images ---
KAFKA_IMAGE=apache/kafka:4.3.1
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
POSTGRES_IMAGE=postgres:18.6

# --- Terraform providers (exact pins; .terraform.lock.hcl is not committed) ---
TF_PROVIDER_DOCKER_VERSION=4.6.0
TF_PROVIDER_KAFKA_VERSION=0.13.1
TF_PROVIDER_POSTGRESQL_VERSION=1.27.0
