# Environment files (credentials come from Terraform, see CLAUDE.md §5)
.env*

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# Machine-specific Terraform overrides
*.local.auto.tfvars

# Reflex build output
.web/
.states/

# Per-run dbt artifacts from the Airflow DAG (F05.4); the folder itself is kept by .gitkeep
airflow-runs/*
!airflow-runs/.gitkeep

# Airflow task logs (F01.5), bind-mounted so they survive container replacement; kept by .gitkeep
airflow-logs/*
!airflow-logs/.gitkeep

# Personal local how-to (not part of the docs)
HOWTO.txt
